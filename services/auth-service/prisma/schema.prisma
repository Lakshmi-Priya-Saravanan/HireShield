generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  name               String?
  role               Role                @default(SEEKER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  scans              Scan[]
  reports            FraudReport[]
  emailVerifications EmailVerification[]
  urlVerifications   UrlVerification[]
  notifications      Notification[]
}

model Scan {
  id                String   @id @default(uuid())
  userId            String?
  jobDescription    String   @db.Text
  companyName       String?
  salaryRange       String?
  url               String?
  email             String?
  fraudScore        Float
  riskLevel         String
  redFlags          String   @db.Text // JSON string list
  featureImportance String   @db.Text // JSON string object
  scannedAt         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id])
}

model FraudReport {
  id              String   @id @default(uuid())
  userId          String
  companyName     String?
  details         String   @db.Text
  status          String   @default("PENDING") // PENDING, REVIEWED, ACTION_TAKEN
  reportedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
}

model Company {
  id              String   @id @default(uuid())
  name            String   @unique
  website         String?
  linkedin        String?
  careersPage     String?
  trustScore      Float    @default(100.0)
  isBlacklisted   Boolean  @default(false)
  verified        Boolean  @default(false)
  riskIndicators  String   @db.Text // JSON string list
  createdAt       DateTime @default(now())
}

model EmailVerification {
  id                 String   @id @default(uuid())
  userId             String?
  email              String
  trustScore         Float
  isDisposable       Boolean
  domainAge          String?
  corporateMatch     Boolean
  companyConsistency Boolean
  checkedAt          DateTime @default(now())

  user               User?    @relation(fields: [userId], references: [id])
}

model UrlVerification {
  id                 String   @id @default(uuid())
  userId             String?
  url                String
  safetyScore        Float
  domainAge          String?
  isHttps            Boolean
  hasRedirects       Boolean
  suspiciousKeywords String   @db.Text // comma-separated
  isBlacklisted      Boolean
  checkedAt          DateTime @default(now())

  user               User?    @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

enum Role {
  SEEKER
  RECRUITER
  ADMIN
}

